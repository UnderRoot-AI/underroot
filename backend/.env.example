# ─── Database ────────────────────────────────────────────────────────────────
#
# Local development (default — relative path, creates file next to the process):
DATABASE_URL=sqlite:///./smart_soil.db
SOIL_REPORT_DATABASE_URL=sqlite:///./soil_reports.db
#
# Render deployment (set these in the Render dashboard when using a Persistent Disk):
# DATABASE_URL=sqlite:////var/data/smart_soil.db
# SOIL_REPORT_DATABASE_URL=sqlite:////var/data/soil_reports.db
#
# NOTE: Four slashes are required for an absolute path in SQLite URLs:
#   sqlite:///  → three slashes = relative path
#   sqlite://// → four slashes = absolute path (e.g. /var/data/...)

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Add your deployed Vercel frontend URL to this list for production, e.g.:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# ─── Storage ──────────────────────────────────────────────────────────────────
# Local development:
UPLOAD_DIR=uploads
# Render deployment (must be inside the Persistent Disk mount path):
# UPLOAD_DIR=/var/data/uploads
MODEL_DIR=ml_models
RAG_DIR=data/knowledge

# ─── SMTP — Gmail ─────────────────────────────────────────────────────────────
#
# Step-by-step Gmail App Password setup:
#
#  1. Sign in to the Gmail account you want to send from (e.g. underroot.soil@gmail.com).
#  2. Open Google Account → Security.
#  3. Enable 2-Step Verification (required before App Passwords work).
#  4. Go back to Security → App passwords.
#  5. Select "Mail" as the app and "Other (Custom name)" as the device.
#     Type "UnderRoot" and click Generate.
#  6. Google shows a 16-character password (e.g. abcd efgh ijkl mnop).
#     Copy it WITHOUT spaces and paste it as SMTP_PASSWORD below.
#  7. Set SMTP_USER and SMTP_FROM to the same Gmail address.
#
# The backend uses port 587 + STARTTLS, which Gmail supports natively.
# No "Less secure apps" toggle is needed when using App Passwords.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password-here
SMTP_FROM=your-gmail-address@gmail.com
EMAIL_FROM_NAME=UnderRoot

# ─── Frontend & password reset ────────────────────────────────────────────────
# Local:
FRONTEND_URL=http://localhost:5173
# Render + Vercel deployment:
# FRONTEND_URL=https://your-app.vercel.app
PASSWORD_RESET_EXPIRE_MINUTES=60

# ─── Hardware ─────────────────────────────────────────────────────────────────
HARDWARE_BAUDRATE=9600
# mock   → simulated SoilX (no physical device needed, safe for development)
# serial → real device via USB/serial (existing serial-probe behaviour)
# ble    → reserved for future SoilX BLE/GATT integration
HARDWARE_MODE=mock

# ─── Developer account ────────────────────────────────────────────────────────
DEVELOPER_EMAIL=change-me@example.com
DEVELOPER_PASSWORD=change-me
# Recommended for production: set a bcrypt hash instead of a plain password.
DEVELOPER_PASSWORD_HASH=

# ─── SMS / Phone OTP ──────────────────────────────────────────────────────────
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PHONE_OTP_EXPIRE_MINUTES=10
